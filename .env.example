# ==============================================================================
# OmniPulse AI Social Media Agent — Environment Variables Reference
# ==============================================================================
# For local frontend development, copy the Frontend variables into .env.local.
# For local backend development, copy the Backend variables into backend/.env.
# For Vercel production deployment, set ALL applicable variables in Vercel Dashboard
# under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Browser-Accessible)
# ------------------------------------------------------------------------------
# Supabase project URL and browser-safe client keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Backend API Base URL
# - In local development: Leave blank or set to http://127.0.0.1:8000
# - On Vercel production: Leave empty or omit (the app automatically uses relative /api)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-SIDE SECRETS (Never exposed to the browser)
# ------------------------------------------------------------------------------
# General Server Environment
ENVIRONMENT=production
PUBLISHING_MODE=live

# Groq LLM API Key (used for post synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Server-Side Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vercel Cron Security Secret (passed via Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_random_generated_secret_here

# ------------------------------------------------------------------------------
# 3. SOCIAL PLATFORM INTEGRATION SECRETS
# ------------------------------------------------------------------------------
# Bluesky (AT Protocol)
BLUESKY_ENABLED=true
BLUESKY_HANDLE=your_handle.bsky.social
BLUESKY_APP_PASSWORD=your_bluesky_app_password

# LinkedIn (OAuth / REST Share Contract)
LINKEDIN_ENABLED=true
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_AUTHOR_URN=urn:li:person:your_person_id

# Facebook (Meta Graph API - Requires Page Access Token & Numeric Page ID)
FACEBOOK_ENABLED=true
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_numeric_page_id

# Instagram (Meta Graph API - Requires Professional/Business Account ID)
INSTAGRAM_ENABLED=true
INSTAGRAM_ACCESS_TOKEN=your_meta_system_user_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
