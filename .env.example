# ==============================================================================
# OmniPulse AI Social Media Agent — Core Environment Variables Reference (.env.example)
# ==============================================================================
# Architecture Overview:
# - Core Application (.env): Server, database, LLM, encryption key, scheduler.
# - Platform Credentials (platform_credentials.env): Social media developer apps,
#   OAuth secrets, and Bluesky protocol credentials.
# - Frontend: React + Vite SPA (reads VITE_* variables).
# - Database: Supabase PostgreSQL (stores encrypted platform tokens & scheduled posts).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Browser-Accessible)
# ------------------------------------------------------------------------------
# Supabase project URL and browser-safe client keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Backend API Base URL
# - In local development: Set to http://127.0.0.1:8000
# - On Vercel production: Leave empty or omit (the app automatically uses relative /api)
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND CORE INFRASTRUCTURE & APPLICATION SECRETS (Server-Side Only)
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
HOST=127.0.0.1
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# Publishing Mode & Scheduling
PUBLISHING_MODE=live
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15

# Groq LLM API Key (used exclusively by backend for AI post synthesis)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Server-Side Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Vercel Cron Security Secret (protects GET /api/v1/scheduler/run-due-cron)
CRON_SECRET=your_random_generated_secret_here

# ------------------------------------------------------------------------------
# 3. CREDENTIAL SECURITY & TOKEN ENCRYPTION AT REST
# ------------------------------------------------------------------------------
# 32-byte urlsafe base64 encryption key for encrypting platform access tokens in Supabase.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=your_32_byte_urlsafe_base64_fernet_key_here

# ------------------------------------------------------------------------------
# 4. SOCIAL MEDIA PLATFORM APPLICATION CREDENTIALS
# ------------------------------------------------------------------------------
# Platform App IDs, OAuth secrets, and connection parameters have been separated
# into 'platform_credentials.env'.
#
# See 'platform_credentials.env.example' for:
# - Meta Developer App ID & Secret (Facebook & Instagram)
# - LinkedIn OAuth App Client ID & Secret
# - Pinterest Developer App ID & Secret
# - Google / YouTube OAuth Client ID & Secret
# - Bluesky AT Protocol Handle & App Password
