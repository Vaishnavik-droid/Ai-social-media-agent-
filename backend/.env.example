# ==========================================
# OmniPulse FastAPI Backend Environment Configuration
# Copy this file to .env and fill in your credentials.
# ==========================================

# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# Publishing Mode & Scheduling
PUBLISHING_MODE=mock
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15

# Groq LLM Configuration (Backend Only - NEVER expose to frontend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Platform 1: Bluesky (AT Protocol)
BLUESKY_ENABLED=false
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Platform 2: LinkedIn
LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Platform 3: Facebook (Page Feed)
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Platform 4: Instagram (Professional/Business)
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
