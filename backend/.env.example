# ==============================================================================
# OmniPulse FastAPI Backend Core Configuration Reference (.env.example)
# ==============================================================================
# Server & Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"]

# Publishing Mode & Scheduling
PUBLISHING_MODE=mock
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15

# Groq LLM Configuration (Backend Only - NEVER expose to frontend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Server-Side Persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron Security Secret
CRON_SECRET=

# Authenticated Token Encryption Key (for credential storage at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Social Media Platform Developer Credentials
# ------------------------------------------------------------------------------
# Platform App IDs, Secrets, and OAuth parameters are configured in
# 'platform_credentials.env'. See 'backend/platform_credentials.env.example'.
