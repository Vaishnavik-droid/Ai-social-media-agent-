# ==============================================================================
# OmniPulse AI — Platform Application Credentials Reference Template (.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to 'platform_credentials.env':
#    cp platform_credentials.env.example platform_credentials.env
# 2. Fill in the client credentials for the platforms you wish to configure.
# 3. Dynamic tokens from OAuth logins are stored encrypted in Supabase.
#    This file ONLY needs developer app credentials (Client IDs & Secrets).
# ==============================================================================

# ------------------------------------------------------------------------------
# SECTION 1: Application IDs & OAuth Client IDs
# ------------------------------------------------------------------------------
# Meta Developer App ID (Facebook & Instagram OAuth)
# Obtain from: https://developers.facebook.com/apps/
META_APP_ID=2231204290777395
META_REDIRECT_URI=http://localhost:8000/api/v1/connections/meta/callback

# LinkedIn OAuth 2.0 Client ID
# Obtain from: https://www.linkedin.com/developers/apps/
LINKEDIN_CLIENT_ID=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/connections/linkedin/callback

# Pinterest Developer App ID (Phase 2B readiness)
# Obtain from: https://developers.pinterest.com/apps/
PINTEREST_APP_ID=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/v1/connections/pinterest/callback

# Google / YouTube OAuth 2.0 Client ID (Phase 2B readiness)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/connections/youtube/callback

# ------------------------------------------------------------------------------
# SECTION 2: Application Secrets (Confidential — Never Commit to Git)
# ------------------------------------------------------------------------------
META_APP_SECRET=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# SECTION 3: Bluesky AT Protocol Configuration
# ------------------------------------------------------------------------------
# Bluesky operates on the decentralized AT Protocol.
# Obtain an App Password from: Bluesky App -> Settings -> App Passwords
BLUESKY_ENABLED=false
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# ------------------------------------------------------------------------------
# SECTION 4: Legacy Platform Tokens (Retained for Reference Only)
# ------------------------------------------------------------------------------
# ARCHITECTURAL NOTICE:
# The variables below are legacy placeholders from previous versions.
# Active OmniPulse authentication uses dynamic OAuth flow with encrypted Supabase
# persistence. These static tokens are NOT used in active verification or publishing.

FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_USER_TOKEN=

LINKEDIN_ENABLED=false
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

